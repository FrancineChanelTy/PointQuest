<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- App Logo -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="173dp"
        android:layout_height="169dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="48dp"
        android:contentDescription="PointQuest Logo"
        android:src="@drawable/screenshot_2026_10_19_131109_removebg_preview" />

    <!-- Student Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/imgStudent"
            android:layout_width="191dp"
            android:layout_height="168dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="Student Image"
            android:src="@drawable/student" />

        <Button
            android:id="@+id/btnStudent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I am a Student"
            android:textSize="16sp"
            android:padding="14dp" />
    </LinearLayout>

    <!-- Staff Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/imgStaff"
            android:layout_width="160dp"
            android:layout_height="165dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="Staff Image"
            android:src="@drawable/_10857085" />

        <Button
            android:id="@+id/btnStaff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I am a Staff"
            android:textSize="16sp"
            android:padding="14dp" />
    </LinearLayout>

</LinearLayout>